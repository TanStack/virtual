{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": [
    "examples/**",
    "benchmarks",
    "packages/marko-virtual/e2e/**"
  ],
  "ignoreDependencies": ["@angular/cli", "babel-plugin-react-compiler"],
  "ignore": ["packages/react-virtual/e2e/app/**"],
  "workspaces": {
    "packages/marko-virtual": {
      "entry": ["src/index.ts", "src/tags/**/*.{ts,marko}", "tests/**/*.ts"],
      "project": ["src/**/*.{ts,marko}", "tests/**/*.ts"],
      "ignoreDependencies": ["marko", "@marko/language-tools"]
    }
  }
}
